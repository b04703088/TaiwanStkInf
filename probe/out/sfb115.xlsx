	});
</script>
<script>
	$(document).ready(function() {
		$('body').scrollspy({
			target : ".top",
			offset : 0
		});
		$(".gotop a").on('click', function(event) {
			if (this.hash !== "") {
				event.preventDefault();
				var hash = this.hash;
				$('html, body').animate({
					scrollTop : $(hash).offset().top
				}, 800, function() {
					window.location.hash = hash;
				});
			}
		});		
	});
</script>
